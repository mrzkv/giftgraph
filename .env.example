# Скопируйте в .env и измените нужные настройки.
# Приоритет: флаги CLI > окружение > .env > встроенные значения.
# Telegram: только чтение существующей пользовательской сессии.

# Необязательно: без этой настройки искать сессию в текущей папке.
# Сначала userbot.session, иначе единственный файл *.session.
# GIFTGRAPH_SESSION=./userbot.session

# Локальные файлы; пути относительно текущей рабочей папки.
GIFTGRAPH_DB=data/gifts.db
GIFTGRAPH_OUTPUT_DIR=outputs

# Лимиты нового обхода. resume использует сохранённые в базе лимиты.
GIFTGRAPH_SEED_LIMIT=100
GIFTGRAPH_DEPTH=3
GIFTGRAPH_MAX_NODES=3000
GIFTGRAPH_MAX_GIFTS=1000
GIFTGRAPH_MAX_PAGES=2000
GIFTGRAPH_PAGE_SIZE=100
GIFTGRAPH_DELAY=1

# Сохранять доступные подписи к подаркам в отдельный JSON.
GIFTGRAPH_GIFT_DESCRIPTION=false

# Для первоначального входа через python generate_session.py:
# получите свои App api_id и App api_hash на https://my.telegram.org/apps,
# раскомментируйте строки ниже и вставьте значения (API_HASH: 32 hex-символа).
# Скрипт читает .env рядом с собой; ключи из окружения имеют приоритет.
# Для сбора с готовой поддерживаемой сессией ключи обычно не нужны.
# API_ID=
# API_HASH=
